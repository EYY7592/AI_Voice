# ScamLens-TW localhost example
SCAMLENS_HOST=127.0.0.1
SCAMLENS_PORT=7861
SCAMLENS_LOG_LEVEL=INFO
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Local-only model root. Model weights are ignored by Git.
SCAMLENS_MODELS_DIR=models
SCAMLENS_DEVICE=cpu

# No API key, Redis, database, or cloud OCR service is required.

# AI_Voice local environment example
#
# Copy this file to `.env` for local notes or deployment tooling.
# Do not put real API keys, tokens, credentials, or user transcript data in git.
#
# The current Python application reads runtime defaults from `config/settings.py`.
# These values are examples for shell scripts, process managers, or future config
# loading only.

# Web server
AI_VOICE_HOST=127.0.0.1
AI_VOICE_PORT=7861
AI_VOICE_LOG_LEVEL=INFO

# Python runtime
PYTHONUTF8=1
PYTHONIOENCODING=utf-8

# Model artifact locations, kept local and ignored by git
AI_VOICE_MODELS_DIR=models
AI_VOICE_MEMORY_INDEX=models/memory/faiss.index
AI_VOICE_MEMORY_METADATA=models/memory/metadata.json

# Optional device preference
AI_VOICE_DEVICE=cuda

# Never commit real secrets.
# OPENAI_API_KEY=
# HF_TOKEN=
# GITHUB_TOKEN=
